generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model DailyReading {
  id        String   @id @default(cuid())
  date      String   @unique
  content   String
  usedLinks String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
